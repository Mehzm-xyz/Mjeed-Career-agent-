{
  "name": "saudi-job-copilot",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 migrations apply JOBS_DB --local",
    "db:remote": "wrangler d1 migrations apply JOBS_DB --remote",
