{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saudi-job-copilot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "browser": {
    "binding": "MYBROWSER"
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "JOBS_DB",
      "database_name": "saudi-job-copilot-db",
      "database_id": "e7e4d9e9-f786-4f59-99e9-310a9ef87257",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "ENABLE_BROWSER_DEMO": "false",
    "ENABLE_JOB_DISCOVERY": "true",
    "ENABLE_CV_FILE_STORAGE": "false"
  },
  "triggers": {
    "crons": [
      "0 6,9,12 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
